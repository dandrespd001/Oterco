---
/**
 * OT-06 — Espacio de imagen pendiente de aprobación (único slot reutilizable).
 *
 * Cada lugar de foto de los capítulos resuelve su recurso con
 * `resolverRecurso(sourceId)` de resources.ts. Sin derivados aprobados
 * (OT-03: DERIVADOS vacío) la resolución es siempre `ausente` y el slot
 * informa el motivo; se emite un placeholder estructural accesible:
 * elemento figure SIN elemento img, sin base64, sin stock ni foto ajena. Texto fijo
 * "fotografía pendiente de aprobación" + fuente documental; nunca el alt
 * original de la fuente (ese alt NO identifica raza ni propiedad).
 *
 * Reserva de dimensiones: el slot declara data-dims (huella documental de
 * resources.ts, solo dimensiones) y reserva proporción con una clase
 * utilitaria .slot--WxH de base.css (OT-11, vía (c)): cero style attributes
 * en dist, compatible con CSP estricta. El bebedero vertical 485×650 además
 * se contiene con la clase .detalle-vertical (columna de detalle, máx.
 * ~560 px de alto, sin ampliación ni recorte engañoso).
 *
 * Trazabilidad interna fuera del HTML público: el sourceId vive solo en
 * código (props, resources.ts); en dist no se emiten data-fuente,
 * data-source, códigos O-D/O-IMG/OT-Q ni rutas 09_FUENTES. El pie visible
 * usa texto neutro ("fuente interna reservada", "fotografía de la finca
 * — pendiente de aprobación").
 *
 * Rama futura: cuando el operador aporte derivados, la unidad de
 * aprobación añade aquí la figura publicada (puertas
 * `esPublicableDerivado` + `altParaPublicar`, nunca este placeholder
 * como contenido). Hoy no existe tal rama: cero elementos img en fuentes y dist.
 */
import {
  fuenteOriginalDe,
  resolverRecurso,
  type SourceId,
} from "../assets/resources";

interface Props {
  /** Huella documental O-IMG01..O-IMG06 (trazabilidad, no contenido). */
  sourceId: SourceId;
  /** Título declarativo del slot (p. ej. "Capítulo Beraka"). */
  titulo: string;
  /** Descripción corta del encuadre reservado, sin certificar nada. */
  descripcion: string;
  /** Clase extra de composición (p. ej. "detalle-vertical" en bebederos). */
  clase?: string;
}

const { sourceId, titulo, descripcion, clase = "" } = Astro.props;
const resolucion = resolverRecurso(sourceId);
const original = fuenteOriginalDe(sourceId);
const dims = `${original.widthOriginal}x${original.heightOriginal}`;
/* OT-11 (c) — proporción como clase estática de base.css, sin inline styles:
   seis originales ⇒ cinco clases (O-IMG02 y O-IMG03 comparten 1100x733). */
const CLASES_PROPORCION: Record<string, string> = {
  "603x423": "slot--603x423",
  "1100x733": "slot--1100x733",
  "485x650": "slot--485x650",
  "1208x605": "slot--1208x605",
  "986x638": "slot--986x638",
};
const claseProporcion = CLASES_PROPORCION[dims] ?? "";
/* Etiqueta neutra: sin sourceId ni dims codificados como trazabilidad. */
const etiqueta = "Espacio de imagen reservado, pendiente de aprobación";
/* Motivo neutro en dist: resolverRecurso se consume de forma real, pero su
   motivo interno (rutas de extracción) no se emite al HTML público. */
const motivo =
  resolucion.estado === "ausente"
    ? " Motivo: sin derivado generado; pendiente de aprobación del operador."
    : "";
---

<figure
  class={["foto-pendiente", claseProporcion, clase].filter(Boolean).join(" ")}
  data-estado="pendienteAP"
  data-dims={dims}
  role="note"
  aria-label={etiqueta}
>
  <strong>{titulo}</strong>
  <span>fotografía pendiente de aprobación</span>
  <figcaption>
    {descripcion} Fuente interna reservada. Fotografía de la finca —
    pendiente de aprobación.{motivo}
  </figcaption>
</figure>
