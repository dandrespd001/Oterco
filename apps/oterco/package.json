{
  "name": "oterco",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "App Astro estática de OTERCO (OT-01: página técnica mínima con datos fixture).",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test tests/",
